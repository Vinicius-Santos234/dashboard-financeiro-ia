# ---------------------------------------------------------------------------
# Firebase — SDK cliente.
# Estas chaves sao PUBLICAS por desenho; o Firebase nao as trata como segredo.
# Quem protege os dados no caminho do cliente sao as firestore.rules.
# Onde achar: console > Configuracoes do projeto > Seus apps > app da Web.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dashboard-financeiro-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dashboard-financeiro-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dashboard-financeiro-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase — Admin SDK. ISTO E SEGREDO.
# Do JSON baixado em console > Configuracoes > Contas de servico.
# A private_key do JSON tem \n literais; cole exatamente como esta la, entre
# aspas — o admin.ts converte para quebra de linha de verdade.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=dashboard-financeiro-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Gemini — entra na E4, ainda nao usada.
GEMINI_API_KEY=

# Dois usuarios de teste para tests/isolamento.test.ts (E1).
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
