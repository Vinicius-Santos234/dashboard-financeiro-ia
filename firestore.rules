rules_version = '2';

// Security Rules — spec §4.4.
//
// ============================================================================
// O CLIENTE NÃO ESCREVE. NADA. EM LUGAR NENHUM.
// ============================================================================
//
// Toda escrita passa pelo servidor (Route Handlers e Server Actions com o Admin
// SDK), que mantém invariantes que o cliente desconhece — sobretudo o rollup
// mensal, atualizado na MESMA transação da transação financeira.
//
// Antes desta versão, as regras diziam `allow create, update, delete: if
// dono(uid)`. A escrita do app já ia toda pelo servidor, então na prática
// ninguém usava aquele caminho — mas ele estava aberto, e por ele um usuário
// autenticado gravava direto pelo SDK cliente, **quebrando a invariante
// transação↔rollup em silêncio**. Pior: contornava por completo a proteção de
// somente-leitura da conta demo pública, que mora no servidor.
//
// Uma regra que permite escrever a FONTE e proíbe escrever o DERIVADO está
// declarando, sem querer, que existe um caminho para corromper.
//
// As validações de formato que viviam aqui (centavos inteiros, mês coerente com
// a data, categoria no enum) foram removidas porque **nunca mais seriam
// alcançadas**: sem escrita de cliente, não há o que validar. Elas continuam
// onde agora importam — nos tipos, no servidor e na suíte de testes. Manter
// regra inalcançável é manter documentação que ninguém executa.
//
// O ADMIN SDK IGNORA TUDO ISTO. A proteção do lado servidor é a árvore de
// caminhos em lib/firestore/paths.ts, não este arquivo.

service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Leitura continua permitida ao dono. É o que mantém o isolamento entre
    // usuários como propriedade testável pelo SDK cliente, e é uma segunda
    // parede caso um ID token vaze.
    match /users/{uid} {
      allow read: if dono(uid);
      allow write: if false;

      match /{documento=**} {
        allow read: if dono(uid);
        allow write: if false;
      }
    }

    // Nada fora de /users/{uid}. Sem esta linha, uma coleção nova criada por
    // engano nasceria sem regra nenhuma.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
